{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/residence-without-work",
      "destination": "/passive-residency",
      "permanent": true
    },
    {
      "source": "/self-employed-residence",
      "destination": "/company-active-residency",
      "permanent": true
    },
    {
      "source": "/company-formation",
      "destination": "/company-active-residency",
      "permanent": true
    },
    {
      "source": "/opening-a-bank-account",
      "destination": "/the-file",
      "permanent": true
    },
    {
      "source": "/parishes",
      "destination": "/where-to-live",
      "permanent": true
    },
    {
      "source": "/parishes/:slug",
      "destination": "/where-to-live",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
