---
interface Props {
  overlay?: boolean;
  current?: string;
}

const { overlay = false, current = "" } = Astro.props;

const links = [
  { href: "/residency-vs-tax", label: "Three things" },
  { href: "/passive-residency", label: "Passive" },
  { href: "/company-active-residency", label: "Company" },
  { href: "/buying-property", label: "Property" },
  { href: "/the-file", label: "The file" },
  { href: "/where-to-live", label: "Where to live" },
  { href: "/shortlist", label: "Shortlist" },
  { href: "/directory", label: "Directory" },
  { href: "/living-in-andorra", label: "Living" },
];

function isCurrent(href: string) {
  return current === href || current.startsWith(`${href}/`);
}
---

<a class="skip-link" href="#main">Skip to content</a>
<nav class:list={["site-nav", { overlay }]}>
  <a href="/" class="logo">Andorra Private</a>
  <details class="nav-menu">
    <summary class="nav-toggle">Menu</summary>
    <div class="nav-links">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </details>
</nav>
