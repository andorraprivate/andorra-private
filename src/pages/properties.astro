---
import Base from "../layouts/Base.astro";
import InterestForm from "../components/InterestForm.astro";
import { listingsByCategory } from "../data/directory";
import { parishes } from "../data/parishes";

const agents = listingsByCategory("property");
---

<Base
  title="Properties in Andorra | How we list homes"
  description="How Andorra Private will list homes: parish, type and situation — without invented houses or borrowed photographs. AGIA-registered agents and a register of interest."
  path="/properties"
>
  <section class="page-header">
    <h1>Properties</h1>
    <p>
      Selected homes for long-term living, not a scraped property portal. Until
      we publish a file we have seen, the list stays empty.
    </p>
  </section>

  <section class="prose wide">
    <div class="notice">
      <p>
        We do not invent houses, prices or photographs. Nothing on this page is
        an offer. Buying or renting in Andorra usually involves an
        AGIA-registered agent, a notary, and — for non-residents — the foreign
        investment rules then in force.
      </p>
    </div>

    <h2>How a listing will appear</h2>
    <p>
      When a home is ready to publish, it will use the same quiet card as the
      rest of the site. The cards below are a template, not houses for sale.
    </p>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="card-grid">
      <div class="listing-card">
        <div class="listing-meta">Template · fields</div>
        <h3>Parish · type · status</h3>
        <p>
          Situation and use — valley apartment, village house, or high-valley
          chalet — without a borrowed photograph or a guessed price.
        </p>
      </div>
      <div class="listing-card">
        <div class="listing-meta">Template · what we will state</div>
        <h3>Only facts we can stand behind</h3>
        <p>
          Parish, approximate setting, number of bedrooms if confirmed, and
          whether the file is for sale, to let, or a private introduction.
          Source named.
        </p>
      </div>
      <div class="listing-card">
        <div class="listing-meta">Template · not published</div>
        <h3>What we will not do</h3>
        <p>
          Stock mountain photographs, copied agency galleries, invented
          inventories, or “from €…” figures we have not been given in writing.
        </p>
      </div>
    </div>

    <div class="empty-listings">
      <div class="listing-meta">Current selection</div>
      <h3>No public listings yet</h3>
      <p>
        The structure is ready. When a property is cleared for this site it will
        appear here, parish by parish. Until then, register your interest or
        speak to a licensed agent.
      </p>
    </div>
  </section>

  <section class="prose">
    <h2>Where people look</h2>
    <p>
      The seven parishes are not interchangeable. The capital and Escaldes are
      practical; Ordino and Canillo are quieter and higher; La Massana and
      Encamp sit on ski valleys; Sant Julià is the southern gate. Read the
      <a href="/parishes">parish notes</a>
      before you instruct a search.
    </p>
    <div class="card-grid">
      {
        parishes.map((parish) => (
          <div class="card">
            <div class="card-label">{parish.label}</div>
            <h3>{parish.name}</h3>
            <p>{parish.summary}</p>
            <a href={`/parishes/${parish.slug}`} class="text-link">
              Parish note
            </a>
          </div>
        ))
      }
    </div>

    <h2>Licensed agents</h2>
    <p>
      The official college of estate agents is
      <a href="https://www.agia.ad/collegiats" target="_blank" rel="noopener"
        >AGIA</a
      >. We list a first set of member firms that publish their own sites. This
      is not an endorsement, and it is not exhaustive.
    </p>
    <div class="card-grid">
      {
        agents.map((agent) => (
          <div class="card">
            <div class="card-label">AGIA register</div>
            <h3>{agent.name}</h3>
            <p>{agent.summary}</p>
            <a href={`/directory/${agent.slug}`} class="text-link">
              Directory note
            </a>
          </div>
        ))
      }
    </div>

    <p>
      Residency files often need proof of accommodation. If you are moving for a
      permit, read
      <a href="/become-a-resident">become a resident</a>
      first, then look at housing. Non-resident buyers should also read
      <a href="/buying-property">buying property</a>
      — foreign-investment rules are not the same as a listing.
    </p>
  </section>

  <InterestForm
    intro="Leave your details and we’ll be in touch regarding properties in Andorra."
    source="properties"
  />
</Base>
