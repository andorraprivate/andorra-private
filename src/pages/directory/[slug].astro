---
import Base from "../../layouts/Base.astro";
import {
  listings,
  listingBySlug,
  listingsByCategory,
  categoryLabels,
} from "../../data/directory";

export function getStaticPaths() {
  return listings.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const item = listingBySlug(slug!);
if (!item) {
  throw new Error(`Unknown directory slug: ${slug}`);
}

const related = listingsByCategory(item.category).filter(
  (entry) => entry.slug !== item.slug,
);
---

<Base
  title={`${item.name} | Andorra Private directory`}
  description={`${item.name} — ${item.summary}`}
  path={`/directory/${item.slug}`}
>
  <section class="page-header">
    <p class="card-label">
      <a href={`/directory#${item.category}`}>{categoryLabels[item.category]}</a>
    </p>
    <h1>{item.name}</h1>
    <p>{item.summary}</p>
  </section>

  <section class="prose">
    <div class="notice">
      <p>
        We are not this organisation and we do not take a fee from the
        listing. Use the official site for contact, hours and current
        services.
      </p>
    </div>

    <h2>Official website</h2>
    <p>
      <a href={item.officialUrl} target="_blank" rel="noopener"
        >{item.officialUrl}</a
      >
    </p>
    {
      item.parish && (
        <>
          <h2>Parish</h2>
          <p>
            Published against{" "}
            {item.parishSlug ? (
              <a href="/where-to-live">{item.parish}</a>
            ) : (
              item.parish
            )}
            . See
            <a href="/where-to-live">where to live</a>
            {" "}for context.
          </p>
        </>
      )
    }

    {
      item.detail && item.detail.length > 0 && (
        <>
          <h2>Notes</h2>
          {item.detail.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </>
      )
    }
    {
      item.furtherLinks && item.furtherLinks.length > 0 && (
        <div class="official-links">
          {item.furtherLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noopener" : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      )
    }

    <h2>Source</h2>
    <p>
      Listed from {item.sourcedFrom}. Contact details live on the official
      site, so they cannot go stale here.
    </p>

    {
      related.length > 0 && (
        <>
          <h2>Also in {categoryLabels[item.category].toLowerCase()}</h2>
          <div class="official-links">
            {related.map((entry) => (
              <a href={`/directory/${entry.slug}`}>{entry.name}</a>
            ))}
          </div>
        </>
      )
    }

    <p>
      <a href="/directory" class="text-link">Back to the directory</a>
    </p>
    <p>
      Related:
      <a href="/become-a-resident">residency</a>,
      <a href="/properties">properties</a>,
      <a href="/living-in-andorra">living in Andorra</a>.
    </p>
  </section>
</Base>
