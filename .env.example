# Public requests stay free until this is the string true.
# Paid labels and the Stripe hook are served by /api/config and /api/checkout.
# Flipping this does not require a rewrite of the pages.
MONETISATION_ENABLED=false

# Neon Postgres. POSTGRES_URL and NEON_DATABASE_URL are accepted aliases.
# If unset, a valid form still succeeds and the submission is logged with a TODO.
DATABASE_URL=

# Optional JSON webhook for the bot inbox at hello@privateandorra.com.
INBOX_WEBHOOK_URL=

# Used only when MONETISATION_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_PRICE_GUIDE=
STRIPE_PRICE_PLAN=
STRIPE_PRICE_CONCIERGE=
